@{

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        ITinder | Main Page
    </title>

    <!-- Bootstrap -->
    <link href="css/bootstrap-4.4.1.css" rel="stylesheet">

</head>
<body>
    <div class="jumbotron jumbotron-fluid text-center" height="0px">
        <h1 class="display-5">ITinder</h1>
        <p class="animated flip infinity">Connecting Peoples.</p>
    </div>
    <div class="container">
        @if (@Model.isAuth)
        {
            <div class="row">
                <div class="details col-md-8">
                    <blockquote>
                        <h3>Main page</h3>
                    </blockquote>

                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="img col-md-3 offset-md-0">
                    <img src="images/02bcba8f0b1acd737491f4f12ad23e54.jpg" alt="" width="200" height="200" class="img-rounded rounded-circle">
                </div>
                <div class="details col-md-8">
                    <blockquote>
                        <h3> Its not your profile</h3>
                        <h5 id="userName">@Model.Name</h5>
                        <p id="userSkills"><em>@Model.Skills</em></p>
                    </blockquote>

                </div>
            </div>
        }

    </div>
    <script src="js/jquery-3.4.1.min.js"></script>

    <!-- Include all compiled plugins (below), or include individual files as needed -->

    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap-4.4.1.js"></script>
    <script src="js/Transitions.js"></script>
</body>
</html>